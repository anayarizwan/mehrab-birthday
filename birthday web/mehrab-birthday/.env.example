# --------------------------------------------------------------- #
# Mehrab's Little Universe - environment configuration              #
# Copy this file to ".env" and fill in real values.                #
#   cp .env.example .env                                           #
# The .env file is git-ignored and should NEVER be committed.       #
# --------------------------------------------------------------- #

# Flask session signing key. Generate a long random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string-at-least-64-chars-long

# Plain-text birthday password (used only if BIRTHDAY_PASSWORD_HASH is unset).
# Change this BEFORE deploying. Default dev password: Mehrab@Lakshmi#Forever26!
BIRTHDAY_PASSWORD=Mehrab@Lakshmi#Forever26!

# Optional: a pre-hashed password (safer than the plain one above).
# Generate one with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# If set, this OVERRIDES BIRTHDAY_PASSWORD.
# BIRTHDAY_PASSWORD_HASH=pbkdf2:sha256:...

# Session lifetime in hours (default 12)
SESSION_LIFETIME_HOURS=12

# Set to "true" when serving over HTTPS so cookies are marked Secure
SESSION_COOKIE_SECURE=false

# Flask debug mode. NEVER enable in production.
FLASK_DEBUG=true

# Port to listen on (default 5000)
PORT=5000
