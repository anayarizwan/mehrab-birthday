# --------------------------------------------------------------- #
# IMPORTANT: never commit personal photos.                         #
# The private_uploads/ folder holds real friendship photographs   #
# and must stay on the server only.                                #
# --------------------------------------------------------------- #
private_uploads/*
!private_uploads/.gitkeep

# Real audio files (keep the README, ignore actual mp3s)
static/audio/*
!static/audio/README.txt
!static/audio/.gitkeep
